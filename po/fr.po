#: data/com.skunkcrafts.Lectern.desktop.in:2
#: data/com.skunkcrafts.Lectern.metainfo.xml.in:7
msgid "Lectern"
msgstr "Lectern"

#: data/com.skunkcrafts.Lectern.desktop.in:3
#: data/com.skunkcrafts.Lectern.metainfo.xml.in:8
msgid "Read Markdown documents"
msgstr "Lire des documents Markdown"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/com.skunkcrafts.Lectern.desktop.in:10
msgid "markdown;md;reader;viewer;document;readme;"
msgstr "markdown;md;lecteur;visionneuse;document;readme;"

#: data/com.skunkcrafts.Lectern.gschema.xml:6
msgid "Window width"
msgstr "Largeur de la fenêtre"

#: data/com.skunkcrafts.Lectern.gschema.xml:10
msgid "Window height"
msgstr "Hauteur de la fenêtre"

#: data/com.skunkcrafts.Lectern.gschema.xml:14
msgid "Whether the window is maximized"
msgstr "Indique si la fenêtre est maximisée"

#: data/com.skunkcrafts.Lectern.gschema.xml:23
msgid "Color scheme"
msgstr "Jeu de couleurs"

#: data/com.skunkcrafts.Lectern.gschema.xml:24
msgid ""
"Whether to follow the system style, or to always use a light or dark style."
msgstr ""
"Indique s’il faut suivre le style du système, ou toujours utiliser un style "
"clair ou sombre."

#: data/com.skunkcrafts.Lectern.gschema.xml:29
#: data/resources/ui/preferences_dialog.blp:34
msgid "Margin"
msgstr "Marge"

#: data/com.skunkcrafts.Lectern.gschema.xml:30
msgid "Space between the window edges and the text, in pixels."
msgstr "Espace entre les bords de la fenêtre et le texte, en pixels."

#: data/com.skunkcrafts.Lectern.gschema.xml:34
msgid "Whether to use the fonts of the system"
msgstr "Indique s’il faut utiliser les polices du système"

#: data/com.skunkcrafts.Lectern.gschema.xml:38
msgid "Document font"
msgstr "Police du document"

#: data/com.skunkcrafts.Lectern.gschema.xml:39
msgid "Font of the text, when not using the fonts of the system."
msgstr "Police du texte, lorsque les polices du système ne sont pas utilisées."

#: data/com.skunkcrafts.Lectern.gschema.xml:43
msgid "Monospace font"
msgstr "Police à chasse fixe"

#: data/com.skunkcrafts.Lectern.gschema.xml:44
msgid "Font of the code, when not using the fonts of the system."
msgstr "Police du code, lorsque les polices du système ne sont pas utilisées."

#: data/com.skunkcrafts.Lectern.gschema.xml:48
msgid "Whether search matches case"
msgstr "Indique si la recherche respecte la casse"

#: data/com.skunkcrafts.Lectern.gschema.xml:52
msgid "Whether search only matches whole words"
msgstr "Indique si la recherche ne trouve que des mots entiers"

#: data/com.skunkcrafts.Lectern.metainfo.xml.in:10
msgid ""
"Lectern is a native Markdown reader for GNOME. It renders CommonMark and "
"GitHub Flavored Markdown documents with GTK widgets, without a web engine."
msgstr ""
"Lectern est un lecteur Markdown natif pour GNOME. Il affiche les documents "
"CommonMark et GitHub Flavored Markdown avec des widgets GTK, sans moteur web."

#: data/com.skunkcrafts.Lectern.metainfo.xml.in:39
msgid "Initial development version."
msgstr "Version de développement initiale."


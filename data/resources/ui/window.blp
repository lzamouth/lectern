using Gtk 4.0;
using Adw 1;

template $LecternWindow: Adw.ApplicationWindow {
	title: "Lectern";
	width-request: 360;
	height-request: 294;

	Adw.Breakpoint {
		condition ("max-width: 640sp")

		setters {
			split_view.collapsed: true;
		}
	}

	content: Adw.ToastOverlay toast_overlay {
		child: Adw.ToolbarView {
			[top]
			Adw.HeaderBar {
				[start]
				Gtk.ToggleButton outline_button {
					visible: false;
					icon-name: "sidebar-show-symbolic";
					tooltip-text: _("Outline");
					action-name: "win.show-outline";
				}

				[start]
				Gtk.Box navigation_box {
					styles [
						"linked",
					]

					Gtk.Button {
						icon-name: "go-previous-symbolic";
						tooltip-text: _("Back");
						action-name: "win.go-back";
					}

					Gtk.Button {
						icon-name: "go-next-symbolic";
						tooltip-text: _("Forward");
						action-name: "win.go-forward";
					}
				}

				[start]
				Adw.SplitButton {
					icon-name: "document-open-symbolic";
					tooltip-text: _("Open…");
					dropdown-tooltip: _("Recent Files");
					action-name: "win.open";

					popover: Gtk.Popover recent_popover {
						child: Gtk.Stack recent_stack {
							Gtk.StackPage {
								name: "list";

								child: Gtk.ScrolledWindow {
									hscrollbar-policy: never;
									max-content-height: 400;
									propagate-natural-height: true;
									propagate-natural-width: true;

									child: Gtk.ListBox recent_list {
										selection-mode: none;

										styles [
											"navigation-sidebar",
										]
									};
								};
							}

							Gtk.StackPage {
								name: "empty";

								child: Gtk.Label {
									label: _("No Recent Files");
									margin-top: 12;
									margin-bottom: 12;
									margin-start: 12;
									margin-end: 12;

									styles [
										"dimmed",
									]
								};
							}
						};
					};
				}

				title-widget: Adw.WindowTitle window_title {
					title: "Lectern";
				};

				[end]
				Gtk.MenuButton {
					primary: true;
					icon-name: "open-menu-symbolic";
					tooltip-text: _("Main Menu");
					menu-model: primary_menu;
				}

				[end]
				Gtk.ToggleButton search_button {
					visible: false;
					icon-name: "edit-find-symbolic";
					tooltip-text: _("Search");
					active: bind search_bar.search-mode-enabled bidirectional;
				}
			}

			[top]
			Gtk.SearchBar search_bar {

				child: Adw.Clamp {
					maximum-size: 600;

					child: Gtk.Box {
						spacing: 6;

						Gtk.SearchEntry search_entry {
							hexpand: true;
							placeholder-text: _("Search in document");
						}

						Gtk.Label match_label {
							// A fixed width keeps the label from moving while typing.
							width-chars: 10;
							xalign: 1;

							styles [
								"dimmed",
								"numeric",
								"match-count",
							]
						}

						Gtk.Button {
							icon-name: "go-up-symbolic";
							tooltip-text: _("Previous Match");
							action-name: "win.find-previous";
						}

						Gtk.Button {
							icon-name: "go-down-symbolic";
							tooltip-text: _("Next Match");
							action-name: "win.find-next";
						}

						Gtk.MenuButton {
							icon-name: "view-more-symbolic";
							tooltip-text: _("Search Options");
							menu-model: search_menu;
						}
					};
				};
			}

			content: Gtk.Stack stack {
				transition-type: crossfade;

				Gtk.StackPage {
					name: "empty";

					child: Adw.StatusPage {
						icon-name: "com.skunkcrafts.Lectern-symbolic";
						title: _("Open a Markdown File");
						description: _("Choose a document to read");

						child: Gtk.Box {
							orientation: vertical;
							spacing: 36;

							Gtk.Button {
								label: _("_Open…");
								use-underline: true;
								halign: center;
								action-name: "win.open";

								styles [
									"pill",
									"suggested-action",
								]
							}

							Adw.Clamp empty_recent_clamp {
								maximum-size: 500;

								child: Gtk.Box {
									orientation: vertical;
									spacing: 12;

									Gtk.Label {
										label: _("Recent Files");
										xalign: 0;

										styles [
											"heading",
										]
									}

									Gtk.ListBox empty_recent_list {
										selection-mode: none;

										styles [
											"boxed-list",
										]
									}
								};
							}
						};
					};
				}

				Gtk.StackPage {
					name: "document";

					child: Adw.OverlaySplitView split_view {
						min-sidebar-width: 200;
						max-sidebar-width: 300;

						sidebar: Gtk.ScrolledWindow {
							hscrollbar-policy: never;

							child: Gtk.ListBox outline_list {
								styles [
									"navigation-sidebar",
								]
							};
						};

						content: Gtk.ScrolledWindow {
							hscrollbar-policy: never;

							child: $LecternMarkdownView markdown_view {};
						};
					};
				}
			};
		};
	};
}

menu search_menu {
	section {
		item {
			label: _("Match _Case");
			action: "win.search-case-sensitive";
		}

		item {
			label: _("Match _Whole Words");
			action: "win.search-whole-words";
		}
	}
}

menu primary_menu {
	section {
		item {
			label: _("_New Window");
			action: "app.new-window";
		}
	}

	section {
		item {
			label: _("Copy _Markdown Source");
			action: "win.copy-source";
		}
	}

	section {
		item {
			label: _("_Preferences");
			action: "app.preferences";
		}

		item {
			label: _("_About Lectern");
			action: "app.about";
		}
	}
}
